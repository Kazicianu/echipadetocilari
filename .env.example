# Copy to .env.local for local preview. Never put real secrets in this example.
# npm run preview loads .env.local; npm run build uses process environment only.
# To load this file for a local build: node --env-file=.env.local scripts/build-static.mjs

# Public build settings. Enable indexing only for the production deployment.
PUBLIC_INDEXABLE=false
PUBLIC_SITE_URL=https://www.echipadetocilari.ro

# Server-only Resend settings. CONTACT_FROM must be on a verified sending domain.
RESEND_API_KEY=
CONTACT_FROM=
# Between 1 and 5 plain email addresses, comma-separated; all receive each message.
CONTACT_TO=contact@echipadetocilari.ro

# Default protection. Supply both Turnstile keys to activate the form.
# Use vercel-waf only on Vercel after enabling its persistent POST rate-limit rule.
# See docs/contact-forms.md. Never emulate VERCEL or VERCEL_ENV locally.
CONTACT_SPAM_PROTECTION=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional additional allowed origins, separated by commas; no wildcard.
# The local preview server adds its localhost/127.0.0.1 origins automatically.
CONTACT_ALLOWED_ORIGINS=

# Local-only bypass also requires NODE_ENV=development; never use for deployment.
# This does not mock Resend: submitting with real mail credentials sends real mail.
CONTACT_DEV_BYPASS_TURNSTILE=false
