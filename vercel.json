{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "trailingSlash": true,
  "functions": {
    "api/contact.js": { "maxDuration": 30 }
  },
  "redirects": [
    {"source": "/services{/}?", "destination": "/#servicii", "permanent": true},
    {"source": "/en/services{/}?", "destination": "/en/#servicii", "permanent": true},
    {"source": "/ex-servicii-seo{/}?", "destination": "/servicii-seo/", "permanent": true},
    {"source": "/ex-creare-site-web{/}?", "destination": "/creare-site-web/", "permanent": true},
    {"source": "/pay-per-click{/}?", "destination": "/agentie-google-ads/", "permanent": true},
    {"source": "/en/ppc-advertising{/}?", "destination": "/en/google-ads-agency/", "permanent": true},
    {"source": "/coming-soon{/}?", "destination": "/", "permanent": true},
    {"source": "/home{/}?", "destination": "/", "permanent": true},
    {"source": "/do-ppc-ninjas-really-exist{/}?", "destination": "/", "permanent": true},
    {"source": "/lets-party-our-end-of-the-year-celebration{/}?", "destination": "/", "permanent": true},
    {"source": "/fun-fun-and-more-fun-come-work-at-beyond{/}?", "destination": "/", "permanent": true},
    {"source": "/will-there-be-a-future-post-facebook{/}?", "destination": "/", "permanent": true},
    {"source": "/always-learn-from-experience-and-past-mistakes{/}?", "destination": "/", "permanent": true},
    {"source": "/case-study-how-to-improve-your-seo-scores{/}?", "destination": "/", "permanent": true},
    {"source": "/the-weekly-podcast-design-meets-technology{/}?", "destination": "/", "permanent": true},
    {"source": "/onward-our-award-winning-creative-campaign{/}?", "destination": "/", "permanent": true},
    {"source": "/the-digital-marketing-revolution-is-here-is-here-now{/}?", "destination": "/", "permanent": true},
    {"source": "/wp-content/uploads/2023/05/banner-7.jpg{/}?", "destination": "/", "permanent": true},
    {
      "source": "/uploads/2024/02/Logo_Echipa_de_Tocilari-1024x1024.webp{/}?",
      "destination": "/wp-content/uploads/2024/02/Logo_Echipa_de_Tocilari-1024x1024.webp",
      "permanent": true
    },
    {
      "source": "/wp-content/2024/02/Logo_Echipa_de_Tocilari-1024x1024.webp{/}?",
      "destination": "/wp-content/uploads/2024/02/Logo_Echipa_de_Tocilari-1024x1024.webp",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:"
        }
      ]
    },
    {
      "source": "/wp-(content|includes)/(.*)",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/wp-(content|includes)/(.*)\\.(woff2|woff|ttf|eot|otf)",
      "missing": [{ "type": "query", "key": "v" }],
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/wp-(content|includes)/(.*)\\.(png|jpe?g|webp|avif|gif|svg|ico)",
      "missing": [{ "type": "query", "key": "v" }],
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/wp-(content|includes)/((?!.*[.](?:woff2|woff|ttf|eot|otf|png|jpe?g|webp|avif|gif|svg|ico)$).*)",
      "missing": [{ "type": "query", "key": "v" }],
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
